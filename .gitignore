# ═══════════════════════════════════════════════════════════════
# Velvet Sync · .gitignore
# Optimizado para Android-only
# ═══════════════════════════════════════════════════════════════

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code (descomentar si quieres incluir configuración)
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
/build/
/coverage/

# ═══════════════════════════════════════════════════════════════
# ANDROID ONLY - Otras plataformas ignoradas
# ═══════════════════════════════════════════════════════════════

# Android - Build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# iOS - Ignorado (no se usa)
/ios/
/ios_old/

# macOS - Ignorado (no se usa)
/macos/

# Linux - Ignorado (no se usa)
/linux/

# Web - Ignorado (no se usa)
/web/

# Windows - Ignorado (no se usa)
/windows/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Secretos
.env
/android/key.properties
/android/app/*.keystore

# APKs (build artifacts)
*.apk

# Otros
/imagenes-referencia/
/.tmp/
activity.log
scripts/*.log
